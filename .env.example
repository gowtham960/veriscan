# Required for real fact-checking (Fact-Triangulation Agent). Without these,
# it returns a clearly-labeled stub result — the graph still runs.
GROQ_API_KEY=
TAVILY_API_KEY=

# Optional — paid deepfake/voice-clone detection APIs. Without these, the
# Media Authenticity Agent still runs on free ffprobe/ffmpeg metadata forensics.
HIVE_API_KEY=
VOICE_CLONE_API_KEY=

# Optional — LangSmith tracing (pure observability overlay, not required for
# anything to function).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=veriscan
